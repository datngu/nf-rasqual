profiles {
  saga {
    executor.name    = 'slurm'
    executor.account = 'nn9114k'
  }
  
  // ADD your hpc setup  bellow
  your_hpc {
    executor.name    = 'slurm'
    executor.account = 'your_account'
    // executor.perCpuMemAllocation = true   // enable only if your Slurm needs --mem-per-cpu
  }

  singularity {
    singularity.enabled     = true
    singularity.autoMounts  = true
    singularity.pullTimeout = '5h'

    conda.enabled           = false
    docker.enabled          = false
    podman.enabled          = false
    shifter.enabled         = false
    charliecloud.enabled    = false
    apptainer.enabled       = false
  }
}
